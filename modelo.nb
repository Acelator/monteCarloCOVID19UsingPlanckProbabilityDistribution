Cell[BoxData[
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"day", " ", "=", " ", "1"}], ",", " ", 
    RowBox[{"day", " ", "<=", " ", "numDays"}], ",", " ", 
    RowBox[{"day", " ", "+=", " ", "delta"}], ",", "\n", "  ", 
    RowBox[{"(*", 
     RowBox[{"Simulating", " ", 
      RowBox[{"Spain", "'"}], "s", " ", "lockdown", " ", "on", " ", "day", " ",
       "20", " ", "by", " ", "reducing", " ", "Ro", " ", "from", " ", "8", " ",
       "to", " ", "3"}], "*)"}], "\n", "  ", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"day", " ", "==", " ", "20"}], ",", " ", 
       RowBox[{"Ro", " ", "=", " ", "3"}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"(*", 
      RowBox[{
      "Execute", " ", "one", " ", "Monte", " ", "Carlo", " ", "time", " ", 
       "step"}], "*)"}], "\n", "  ", 
     RowBox[{"timeStep", "[", "day", "]"}], ";", "\n", "  ", 
     RowBox[{"(*", 
      RowBox[{
      "Store", " ", "cumulative", " ", "counts", " ", "at", " ", "the", " ", 
       "end", " ", "of", " ", "the", " ", "day"}], "*)"}], "\n", "  ", 
     RowBox[{
      RowBox[{"historyS", "[", 
       RowBox[{"[", "day", "]"}], "]"}], " ", "=", " ", 
      RowBox[{"Total", "[", "susceptibles", "]"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"historyI", "[", 
       RowBox[{"[", "day", "]"}], "]"}], " ", "=", " ", 
      RowBox[{"Total", "[", "infected", "]"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"historyR", "[", 
       RowBox[{"[", "day", "]"}], "]"}], " ", "=", " ", 
      RowBox[{"Total", "[", "recovered", "]"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"historyD", "[", 
       RowBox[{"[", "day", "]"}], "]"}], " ", "=", " ", 
      RowBox[{"Total", "[", "dead", "]"}]}], ";", "\n", "  ", 
     RowBox[{"(*", 
      RowBox[{"Compute", " ", "daily", " ", "increment", " ", "of", " ", 
       RowBox[{"deaths", ":", " ", 
        RowBox[{"Delta", " ", "D", 
         RowBox[{"(", "t", ")"}]}]}]}], "*)"}], "\n", "  ", 
     RowBox[{
      RowBox[{"dailyDeaths", "[", 
       RowBox[{"[", "day", "]"}], "]"}], " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"day", " ", "==", " ", "1"}], ",", " ", 
        RowBox[{"historyD", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"historyD", "[", 
          RowBox[{"[", "day", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"historyD", "[", 
          RowBox[{"[", 
           RowBox[{"day", " ", "-", " ", "1"}], "]"}], "]"}]}]}], "]"}]}], 
     ";"}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{4.000967571409835*^9, 4.000967574002323*^9}, {
  4.001643014541868*^9, 4.001643102395179*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"2ad4ab68-639b-4b9f-bee7-d1d42d01f0d0"],

