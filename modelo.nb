Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Semilla", " ", "aleatoria", " ", "y", " ", "reinicio", " ", 
    "de", " ", "par\[AAcute]metros", " ", "y", " ", "cuadr\[IAcute]cula"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Ro", "=", "8"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"numDays", "=", "200"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"susceptibles", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"1", ",", "numberOfCells"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"infected", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "numberOfCells"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"recovered", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "numberOfCells"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dead", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "numberOfCells"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"infectionTime", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "numberOfCells"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Paciente", " ", "cero", " ", "k0", " ", "en", " ", "el", " ", "centro"}],
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"k0", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Quotient", "[", 
        RowBox[{"L", ",", "2"}], "]"}], "*", "L"}], "+", 
      RowBox[{"Quotient", "[", 
       RowBox[{"L", ",", "2"}], "]"}], "+", "1"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"susceptibles", "[", 
      RowBox[{"[", "k0", "]"}], "]"}], "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"infected", "[", 
      RowBox[{"[", "k0", "]"}], "]"}], "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"infectionTime", "[", 
      RowBox[{"[", "k0", "]"}], "]"}], "=", "0"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Vectores", " ", "hist\[OAcute]ricos"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"historyS", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "numDays"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"historyI", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "numDays"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"historyR", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "numDays"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"historyD", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "numDays"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dailyDeaths", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", "numDays"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Funci\[OAcute]n", " ", "para", " ", "capturar", " ", "el", " ", "estado",
      " ", "2", "D", " ", "actual"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"getCurrentGrid", "[", "]"}], ":=", 
     RowBox[{"Partition", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "*", "susceptibles"}], "+", 
        RowBox[{"2", "*", "infected"}], "+", 
        RowBox[{"3", "*", "recovered"}], "+", 
        RowBox[{"4", "*", "dead"}]}], ",", "L"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"gridSnapshots", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"getCurrentGrid", "[", "]"}]}], "}"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Bucle", " ", "temporal", " ", "principal", " ", "de", " ", 
     "Monte", " ", "Carlo"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"day", "=", "1"}], ",", 
      RowBox[{"day", "<=", "numDays"}], ",", 
      RowBox[{"day", "+=", "delta"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"day", "==", "20"}], ",", 
         RowBox[{"Ro", "=", "3"}]}], "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "Confinamiento", " ", "en", " ", "el", " ", "d\[IAcute]a", " ", 
         "20"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"timeStep", "[", "day", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"historyS", "[", 
         RowBox[{"[", "day", "]"}], "]"}], "=", 
        RowBox[{"Total", "[", "susceptibles", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"historyI", "[", 
         RowBox[{"[", "day", "]"}], "]"}], "=", 
        RowBox[{"Total", "[", "infected", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"historyR", "[", 
         RowBox[{"[", "day", "]"}], "]"}], "=", 
        RowBox[{"Total", "[", "recovered", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"historyD", "[", 
         RowBox[{"[", "day", "]"}], "]"}], "=", 
        RowBox[{"Total", "[", "dead", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"dailyDeaths", "[", 
         RowBox[{"[", "day", "]"}], "]"}], "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"day", "==", "1"}], ",", 
          RowBox[{"historyD", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"historyD", "[", 
            RowBox[{"[", "day", "]"}], "]"}], "-", 
           RowBox[{"historyD", "[", 
            RowBox[{"[", 
             RowBox[{"day", "-", "1"}], "]"}], "]"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Captura", " ", "cada", " ", "5", " ", "d\[IAcute]as", " ", "para", " ",
          "el", " ", "GIF", " ", "y", " ", "en", " ", "el", " ", 
         "\[UAcute]ltimo", " ", "d\[IAcute]a"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"day", ",", "5"}], "]"}], "==", "0"}], "||", 
          RowBox[{"day", "==", "numDays"}]}], ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"gridSnapshots", ",", 
            RowBox[{"{", 
             RowBox[{"day", ",", 
              RowBox[{"getCurrentGrid", "[", "]"}]}], "}"}]}], "]"}], ";"}]}],
         "]"}], ";"}]}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Gr\[AAcute]ficas", " ", "de", " ", "evoluci\[OAcute]n", " ", 
     "temporal", " ", 
     RowBox[{"(", 
      RowBox[{"Plot", " ", "1", " ", "y", " ", "Plot", " ", "2"}], ")"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotSIR", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "historyS", ",", "historyI", ",", "historyR", ",", "historyD"}], 
        "}"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Susceptible S(t)\>\"", ",", "\"\<Infected I(t)\>\"", 
          ",", "\"\<Recovered R(t)\>\"", ",", "\"\<Dead D(t)\>\""}], "}"}]}], 
       ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Green", ",", "Red", ",", "Blue", ",", "Yellow"}], "}"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Days\>\"", ",", "\"\<Number of Individuals\>\""}], 
         "}"}]}], ",", 
       RowBox[{
       "PlotLabel", 
        "->", "\"\<Monte Carlo Planck (MCP) Model Evolution\>\""}], ",", 
       RowBox[{"ImageSize", "->", "400"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotDeaths", "=", 
     RowBox[{"DiscretePlot", "[", 
      RowBox[{
       RowBox[{"dailyDeaths", "[", 
        RowBox[{"[", "t", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "1", ",", "numDays"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Purple"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Days\>\"", ",", "\"\<Deaths / Day\>\""}], "}"}]}], ",", 
       
       RowBox[{
       "PlotLabel", "->", "\"\<Daily Deaths (with Lockdown at Day 20)\>\""}], 
       ",", 
       RowBox[{"ImageSize", "->", "400"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"plotSIR", ",", 
        RowBox[{"Spacer", "[", "20", "]"}], ",", "plotDeaths"}], "}"}], "]"}],
      "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Generaci\[OAcute]n", " ", "de", " ", "TODOS", " ", "los", " ",
      "fotogramas", " ", "para", " ", "el", " ", "GIF"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allGifPlots", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", "snapshot", "}"}], ",", 
         RowBox[{"ArrayPlot", "[", 
          RowBox[{
           RowBox[{"snapshot", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{"ColorRules", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"1", "->", "Green"}], ",", 
              RowBox[{"2", "->", "Red"}], ",", 
              RowBox[{"3", "->", "Blue"}], ",", 
              RowBox[{"4", "->", "Yellow"}]}], "}"}]}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"FrameTicks", "->", "None"}], ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"\"\<Day \>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"snapshot", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", "Bold", ",", 
              "12"}], "]"}]}], ",", 
           RowBox[{"ImageSize", "->", "220"}]}], "]"}]}], "]"}], ",", 
       "gridSnapshots"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "5.", " ", "Selecci\[OAcute]n", " ", "de", " ", "1", " ", "de", " ", 
     "cada", " ", "5", " ", "capturas", " ", "para", " ", "el", " ", 
     "Mosaico", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"d\[IAcute]as", " ", "0"}], ",", "25", ",", "50", ",", "...", ",",
        "200"}], ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"salto", "=", "4"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"selectedSnapshots", "=", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"gridSnapshots", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", 
           RowBox[{"-", "1"}], ";;", "salto"}], "]"}], "]"}], ",", 
        RowBox[{"Last", "[", "gridSnapshots", "]"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"plotsGrid", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", "snapshot", "}"}], ",", 
         RowBox[{"ArrayPlot", "[", 
          RowBox[{
           RowBox[{"snapshot", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{"ColorRules", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"1", "->", "Green"}], ",", 
              RowBox[{"2", "->", "Red"}], ",", 
              RowBox[{"3", "->", "Blue"}], ",", 
              RowBox[{"4", "->", "Yellow"}]}], "}"}]}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"FrameTicks", "->", "None"}], ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"\"\<Day \>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"snapshot", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", "Bold", ",", 
              "12"}], "]"}]}], ",", 
           RowBox[{"ImageSize", "->", "180"}]}], "]"}]}], "]"}], ",", 
       "selectedSnapshots"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"mosaico", "=", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{"plotsGrid", ",", 
         RowBox[{"UpTo", "[", "3", "]"}]}], "]"}], ",", 
       RowBox[{"Spacings", "->", 
        RowBox[{"{", 
         RowBox[{"1.5", ",", "1.5"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "6.", " ", "Guardado", " ", "autom\[AAcute]tico", " ", "en", " ", "la", " ",
      "carpeta", " ", "del", " ", "Notebook"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"SetDirectory", "[", 
     RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"\"\<simulacion_covid40.gif\>\"", ",", "allGifPlots", ",", 
      RowBox[{"\"\<DisplayDurations\>\"", "->", "0.5"}], ",", 
      RowBox[{"\"\<AnimationRepetitions\>\"", "->", "Infinity"}]}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"\"\<mosaico_evolucion_espacial40.png\>\"", ",", "mosaico", ",", 
      
      RowBox[{"ImageResolution", "->", "300"}]}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\[DownExclamation]Archivos 'simulacion_covid.gif' y \
'mosaico_evolucion_espacial.png' guardados correctamente!\>\"", "]"}], ";"}], 
   "\n", "mosaico"}]}]], "Input",
