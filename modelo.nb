 CellChangeTimes->{{4.0009675573623867`*^9, 
  4.0009675593864937`*^9}},ExpressionUUID->"eb02fa84-9c3f-4e60-b7ea-\
b254c4a8dc3c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Avanza", " ", "el", " ", "estado", " ", "epid\[EAcute]mico", " ", "un", " ",
     "d\[IAcute]a", " ", 
    RowBox[{"(", 
     RowBox[{"paso", " ", "de", " ", "tiempo", " ", "discreto", " ", "t"}], 
     ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"timeStep", "[", "t_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"activeInfected", ",", 
        RowBox[{"(*", 
         RowBox[{
         "Lista", " ", "de", " ", "celdas", " ", "que", " ", "ya", " ", 
          "estaban", " ", "infectadas", " ", "al", " ", "inicio", " ", "de", " ",
           "t"}], "*)"}], "R", ",", "n", ",", "nInteraction", ",", "targets", 
        ",", "susceptibleTargets", ",", "newInfections", ",", "infectedCells",
         ",", "remProbability", ",", "isRemoved", ",", "isDead"}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"PASO", " ", "0"}], ":", 
        RowBox[{
        "Captura", " ", "s\[IAcute]ncrona", " ", "de", " ", "los", " ", 
         "infectados", " ", "activos", " ", "al", " ", "inicio", " ", "del", " ",
          "d\[IAcute]a", " ", "t"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"activeInfected", "=", 
        RowBox[{"Pick", "[", 
         RowBox[{
          RowBox[{"Range", "[", "numberOfCells", "]"}], ",", "infected", ",", 
          "1"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "activeInfected", "]"}], "==", "0"}], ",", 
         RowBox[{"Return", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"FASE", " ", 
         RowBox[{"I", ":", 
          RowBox[{"Proceso", " ", "de", " ", "propagaci\[OAcute]n", " ", 
           RowBox[{"(", 
            RowBox[{"Contagio", " ", "local"}], ")"}]}]}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"n", "=", 
           RowBox[{"RandomVariate", "[", "nDist", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"nInteraction", "=", 
           RowBox[{"stochasticRound", "[", 
            RowBox[{"n", "*", "1", "*", "sigma"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"nInteraction", ">", "0"}], ",", 
            RowBox[{
             RowBox[{"R", "=", 
              RowBox[{"RandomVariate", "[", "Rdist", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
              "3.", " ", "Obtenemos", " ", "los", " ", "N_int", " ", 
               "objetivos", " ", "en", " ", "la", " ", "regi\[OAcute]n", " ", 
               "cuadrada", " ", "de", " ", "lado", " ", "2", 
               RowBox[{"R", "."}]}], "*)"}], 
             RowBox[{"targets", "=", 
              RowBox[{"pickTargets", "[", 
               RowBox[{"k", ",", "R", ",", "nInteraction"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
              "Eliminamos", " ", "duplicados", " ", "por", " ", "si", " ", 
               "el", " ", "muestreo", " ", "con", " ", "reemplazo", " ", 
               "eligi\[OAcute]", " ", "dos", " ", "veces", " ", "la", " ", 
               "misma", " ", "celda"}], "*)"}], "\[IndentingNewLine]", 
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"susceptibles", "[", 
                   RowBox[{"[", "x", "]"}], "]"}], "==", "1"}], ",", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"RandomVariate", "[", 
                    RowBox[{"BernoulliDistribution", "[", "pi", "]"}], "]"}], 
                    "==", "1"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"susceptibles", "[", 
                    RowBox[{"[", "x", "]"}], "]"}], "=", "0"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"infected", "[", 
                    RowBox[{"[", "x", "]"}], "]"}], "=", "1"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"infectionTime", "[", 
                    RowBox[{"[", "x", "]"}], "]"}], "=", "t"}], ";"}]}], 
                   "]"}], ";"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "targets"}], "}"}]}], "]"}], ";"}]}], 
           "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "activeInfected"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"FASE", " ", 
         RowBox[{"II", ":", 
          RowBox[{"Proceso", " ", "de", " ", "retiro"}]}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Se", " ", "ejecuta", " ", "una", " ", "vez", " ", "procesados", " ",
           "todos", " ", "los", " ", "contagios", " ", "del", " ", 
          "d\[IAcute]a", " ", "t"}], ","}], "*)"}], 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"remProbability", "=", 
           RowBox[{"removalFunction", "[", 
            RowBox[{"t", "-", 
             RowBox[{"infectionTime", "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"isRemoved", "=", 
           RowBox[{"RandomVariate", "[", 
            RowBox[{"BernoulliDistribution", "[", "remProbability", "]"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"isRemoved", "==", "1"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"infected", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "=", "0"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
              "Decidimos", " ", "si", " ", "el", " ", "retiro", " ", 
               "corresponde", " ", "a", " ", "fallecimiento", " ", 
               RowBox[{"(", "pd", ")"}], " ", "o", " ", 
               "recuperaci\[OAcute]n"}], "*)"}], 
             RowBox[{"isDead", "=", 
              RowBox[{"RandomVariate", "[", "deathProbability", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"isDead", "==", "1"}], ",", 
               RowBox[{
                RowBox[{"dead", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "=", "1"}], ",", 
               RowBox[{
                RowBox[{"recovered", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "=", "1"}]}], "]"}], ";"}]}],
            "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "activeInfected"}], "}"}]}], "]"}], ";"}]}], 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.001643214974173*^9, 4.001643335280995*^9}, {
  4.001643396832818*^9, 4.0016435105996313`*^9}, {4.001643631150778*^9, 
  4.0016436592068043`*^9}, {4.001643711932767*^9, 4.001643713067746*^9}, {
