Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Plot", " ", "3"}], ":", " ", 
    RowBox[{
    "2", "D", " ", "Spatial", " ", "Grid", " ", "Map", " ", "of", " ", "the", 
