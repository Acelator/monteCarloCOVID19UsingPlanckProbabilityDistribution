Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "History", " ", "arrays", " ", "to", " ", "store", " ", "daily", " ", 
     "totals", " ", "S", 
     RowBox[{"(", "t", ")"}]}], ",", " ", 
